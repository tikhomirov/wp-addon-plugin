#: src/Config/main.php:209
msgid "SEO Settings"
msgstr ""

#: src/Config/main.php:213
msgid "Set Alt in updload from Title media"
msgstr ""

#: src/Config/main.php:215
msgid "If an uploaded image has an empty alt attribute, uses the media library title. Helps with accessibility and SEO."
msgstr ""

#: src/Config/main.php:219
msgid "Enable transliteration?"
msgstr ""

#: src/Config/main.php:221
msgid "Transliterates Cyrillic to Latin for post, category, and filename slugs. Handy for Russian sites with Latin URLs."
msgstr ""

#: src/Config/main.php:225
msgid "⚠️ Disable site indexing."
msgstr ""

#: src/Config/main.php:227
msgid "Adds meta robots noindex on every page of the site. Use on test or staging hosts so search engines do not index a draft site. Different from Tweaks \"Noindex for search, attachment and date archives\", which only targets low-value archive pages."
msgstr ""

#: src/Config/main.php:235
msgid "Data Base Optimization"
msgstr ""

#: src/Config/main.php:239
msgid "Write right link to guid for New posts."
msgstr ""

#: src/Config/main.php:241
msgid "When saving a new post, writes its permalink into guid instead of a temporary ?p=ID URL. Useful for RSS and some integrations."
msgstr ""

#: src/Config/main.php:245
msgid "⚠️ This option enable interface for replace wp guide to right GUID."
msgstr ""

#: src/Config/main.php:247
msgid "Opens an admin tool for bulk viewing and replacing GUID values. Change GUIDs deliberately — RSS subscribers may receive duplicate items."
msgstr ""

#: src/Config/main.php:255
msgid "Admin dashboard widgets"
msgstr ""

#: src/Config/main.php:259
msgid "Add all types at a glance widget"
msgstr ""

#: src/Config/main.php:261
msgid "Expands the At a Glance widget on the admin dashboard: shows all public post types, taxonomies, and the user count."
msgstr ""

#: src/Config/main.php:265
msgid "Plugins list"
msgstr ""

#: src/Config/main.php:267
msgid "Adds a list of installed plugins with versions to the dashboard. Visible to administrators only."
msgstr ""

#: src/Config/main.php:273
msgid "Shows server, domain, and WP_DEBUG information. Useful for diagnostics, but avoid enabling on shared hosting unless needed."
msgstr ""

#: src/Config/main.php:279
msgid "Adds a WordPress roles list widget to the dashboard. Helps you recall role slugs when configuring permissions."
msgstr ""

#: src/Config/main.php:288
msgid "Contact Form 7 settings"
msgstr ""

#: src/Config/main.php:292
msgid "Show additional shortcode?"
msgstr ""

#: src/Config/main.php:294
msgid "Shows a hint with extra CF7 shortcodes: date, time, URL, IP, and user agent. Handy when collecting technical data from a form."
msgstr ""

#: src/Config/main.php:304
msgid "Polylang settings"
msgstr ""

#: src/Config/main.php:309
msgid "Hide languages in wp Front. Enter lang slug, separated: \", \"."
msgstr ""

#: src/Config/main.php:311
msgid "List of Polylang language slugs to hide in the frontend switcher. Example: en, de. Spaces after commas are allowed."
msgstr ""

#: src/Config/tweaks.php:22
msgid "Remove WP-Version in Header"
msgstr ""

#: src/Config/tweaks.php:24
msgid "Removes the WordPress version number from page HTML and RSS. A small security measure: attackers have a harder time targeting a specific WP version."
msgstr ""

#: src/Config/tweaks.php:28
msgid "WP-Emojis deacivation"
msgstr ""

#: src/Config/tweaks.php:30
msgid "Disables WordPress emoji scripts and styles. Pages load faster, especially if you do not use emoji in content."
msgstr ""

#: src/Config/tweaks.php:34
msgid "Remove Windows Live Writer"
msgstr ""

#: src/Config/tweaks.php:36
msgid "Removes the wlwmanifest link from the head. It was only needed for the old Windows Live Writer app and is not required on modern sites."
msgstr ""

#: src/Config/tweaks.php:40
msgid "Remove RSD-Link"
msgstr ""

#: src/Config/tweaks.php:42
msgid "Removes the RSD link for external editors. It is an extra technical tag in the head that is usually unused."
msgstr ""

#: src/Config/tweaks.php:46
msgid "⚠️ Remove RSS links"
msgstr ""

#: src/Config/tweaks.php:48
msgid "Removes RSS feed links from the head. Enable only if you are sure RSS is not needed. For a blog it is usually better to leave this off so readers and aggregators can find your feed."
msgstr ""

#: src/Config/tweaks.php:52
msgid "Remove shortlink in the header"
msgstr ""

#: src/Config/tweaks.php:54
msgid "Removes the shortlink — a short service URL for the page. It is not needed for SEO or visitors."
msgstr ""

#: src/Config/tweaks.php:58
msgid "Remove adjacent links to posts in the header"
msgstr ""

#: src/Config/tweaks.php:60
msgid "Removes link rel=\"prev/next\" from the head. If the theme already outputs previous/next post navigation, this tag is redundant."
msgstr ""

#: src/Config/tweaks.php:64
msgid "Set limit post revisions to 5"
msgstr ""

#: src/Config/tweaks.php:66
msgid "Limits the number of saved post revisions to 5. This reduces database size without hurting day-to-day editing."
msgstr ""

#: src/Config/tweaks.php:70
msgid "⚠️ Block WordPress.org update HTTP requests"
msgstr ""

#: src/Config/tweaks.php:72
msgid "Blocks background requests to api.wordpress.org and downloads.wordpress.org. Useful on closed servers, but WordPress will stop checking core, plugin, and theme updates. Skipped automatically when General Settings → Disable all updates is enabled."
msgstr ""

#: src/Config/tweaks.php:76
msgid "⚠️ Disable heartbeat on frontend (slow down in admin)"
msgstr ""

#: src/Config/tweaks.php:78
msgid "Disables Heartbeat on the public site and slows it down in the admin. This reduces extra AJAX requests. Post autosave remains, but runs less often."
msgstr ""

#: src/Config/tweaks.php:82
msgid "⚠️ Remove jQuery Migrate"
msgstr ""

#: src/Config/tweaks.php:84
msgid "Removes jquery-migrate on the frontend. It may speed up the site but can break older themes and plugins. Enable only after checking forms, sliders, and menus."
msgstr ""

#: src/Config/tweaks.php:88
msgid "Disable new themes on major WP updates"
msgstr ""

#: src/Config/tweaks.php:90
msgid "Prevents WordPress from installing a new default theme during a major core update. Convenient if you use only your own theme."
msgstr ""

#: src/Config/tweaks.php:94
msgid "Disable XML-RPC"
msgstr ""

#: src/Config/tweaks.php:96
msgid "Disables XML-RPC — an old interface for remote publishing and some attacks. If you do not publish via external XML-RPC apps, it is safer to keep this enabled."
msgstr ""

#: src/Config/tweaks.php:100
msgid "Remove post by email function"
msgstr ""

#: src/Config/tweaks.php:102
msgid "Disables publishing posts by email. Almost nobody needs this feature, and it is better to close an unused entry point."
msgstr ""

#: src/Config/tweaks.php:106
msgid "⚠️ Disable agressive update"
msgstr ""

#: src/Config/tweaks.php:108
msgid "Disables automatic update checks on every admin visit. Reduces load, but even administrators will not see update notices until they open Updates manually. Skipped automatically when General Settings → Disable all updates is enabled."
msgstr ""

#: src/Config/tweaks.php:112
msgid "Disable URL auto-linking in comments"
msgstr ""

#: src/Config/tweaks.php:114
msgid "Stops URLs in comments from being turned into clickable links automatically. Useful against spam and unwanted outbound links in comments. Different from General Settings → Disable link Nofollow in comment, which only removes rel=\"nofollow\"."
msgstr ""

#: src/Config/tweaks.php:118
msgid "Remove login-shake on errors"
msgstr ""

#: src/Config/tweaks.php:120
msgid "Removes the login form shake on wrong username or password. It does not affect site behavior — only the login page animation."
msgstr ""

#: src/Config/tweaks.php:124
msgid "Empty WP-Trash every 14 days"
msgstr ""

#: src/Config/tweaks.php:126
msgid "Automatically empties the WordPress trash after 14 days. Helps keep deleted posts and comments from bloating the database."
msgstr ""

#: src/Config/tweaks.php:130
msgid "⚠️ Allow download types file: SVG, DOC, djv .."
msgstr ""

#: src/Config/tweaks.php:132
msgid "Allows uploading additional file types: SVG, DOC, WebP, and others. SVG is handy for icons but may contain malicious code — upload only trusted files. Also adds WebP and SVG MIME types; use settings 34 and 35 below for media library preview support."
msgstr ""

#: src/Config/tweaks.php:136
msgid "Disable pingback from this site to this site"
msgstr ""

#: src/Config/tweaks.php:138
msgid "Prevents the site from sending pingbacks to itself. This is useless load and sometimes a source of spam."
msgstr ""

#: src/Config/tweaks.php:142
msgid "Hide adminbar in frontend for contributors, authors and subscribers"
msgstr ""

#: src/Config/tweaks.php:144
msgid "Hides the admin bar on the frontend for authors, contributors, and subscribers. Editors and administrators still see it."
msgstr ""

#: src/Config/tweaks.php:148
msgid "Add VK and OK to user profile"
msgstr ""

#: src/Config/tweaks.php:150
msgid "Adds VK and Odnoklassniki fields to the user profile and removes outdated AIM/Jabber/Yahoo IM fields."
msgstr ""

#: src/Config/tweaks.php:154
msgid "Showing usages memory and time generate site page"
msgstr ""

#: src/Config/tweaks.php:156
msgid "Shows page generation time and memory usage in an HTML comment at the bottom of the page. Visible only to administrators. Better to leave off on production."
msgstr ""

#: src/Config/tweaks.php:160
msgid "⚠️ Remove Standard WP widget"
msgstr ""

#: src/Config/tweaks.php:162
msgid "Removes all default WordPress widgets from the available list. Dangerous on unfamiliar sites: you can lose already configured sidebar blocks."
msgstr ""

#: src/Config/tweaks.php:166
msgid "AutoRemove readme.html and license.txt files"
msgstr ""

#: src/Config/tweaks.php:168
msgid "Deletes readme.html and license.txt from the site root when an administrator opens the admin. These files can reveal the WordPress version to outsiders."
msgstr ""

#: src/Config/tweaks.php:172
msgid "Add search filter for taxonomy checklists in post editor"
msgstr ""

#: src/Config/tweaks.php:174
msgid "Adds a search field above category and tag lists in the post editor. Very helpful when you have many terms."
msgstr ""

#: src/Config/tweaks.php:178
msgid "Keep selected taxonomy terms in place (disable checked on top)"
msgstr ""

#: src/Config/tweaks.php:180
msgid "Does not move selected categories and tags to the top of the list. Makes long category trees easier to scan."
msgstr ""

#: src/Config/tweaks.php:184
msgid "If posts have status \"pending\" show numbers it in menu"
msgstr ""

#: src/Config/tweaks.php:186
msgid "Shows a Pending count next to the Posts menu item in the admin."
msgstr ""

#: src/Config/tweaks.php:190
msgid "Showing message \"Update wordpress\" only admin"
msgstr ""

#: src/Config/tweaks.php:192
msgid "Hides WordPress update notices from editors, authors, and other users without administrator rights."
msgstr ""

#: src/Config/tweaks.php:196
msgid "Repalse [...] to \"Read more ...\" for posts"
msgstr ""

#: src/Config/tweaks.php:198
msgid "Replaces the default [...] excerpt marker with a Read more... link."
msgstr ""

#: src/Config/tweaks.php:202
msgid "Allow shortcode in \"Text\" widget"
msgstr ""

#: src/Config/tweaks.php:204
msgid "Allows shortcodes to run in text and block widgets. Needed if you insert [shortcode] directly into a widget."
msgstr ""

#: src/Config/tweaks.php:208
msgid "⚠️ Get jquery from google cloud"
msgstr ""

#: src/Config/tweaks.php:210
msgid "Loads jQuery from Google CDN instead of the WordPress bundled version. It may speed up loading but often breaks theme and plugin compatibility. Better to leave off by default."
msgstr ""

#: src/Config/tweaks.php:214
msgid "⚠️ Disable shortcode_unautop (keep paragraph tags around shortcodes)"
msgstr ""

#: src/Config/tweaks.php:216
msgid "Disables automatic <p> wrapping around shortcodes. Needed only if layout around shortcodes breaks. Not required on most sites."
msgstr ""

#: src/Config/tweaks.php:220
msgid "Allow WEBP support for media"
msgstr ""

#: src/Config/tweaks.php:222
msgid "Allows uploading and previewing WebP images in the media library. WebP is also allowed by setting 19 above; this option adds preview support in the library."
msgstr ""

#: src/Config/tweaks.php:226
msgid "Allow SVG support for media"
msgstr ""

#: src/Config/tweaks.php:228
msgid "Helps SVG files display correctly in the media library. Works together with setting 19 above, which allows SVG uploads."
msgstr ""

#: src/Config/tweaks.php:232
msgid "Disable browser checking in dashboard"
msgstr ""

#: src/Config/tweaks.php:234
msgid "Disables outdated browser checks in the WordPress dashboard. Removes an extra request to WordPress.org and annoying warnings."
msgstr ""

#: src/Config/tweaks.php:238
msgid "Change login error message"
msgstr ""

#: src/Config/tweaks.php:240
msgid "Shows a generic Incorrect username or password message instead of hints like that user does not exist. This improves login page security."
msgstr ""

#: src/Config/tweaks.php:244
msgid "⚠️ Extend login session to 1 year when \"Remember Me\" is checked"
msgstr ""

#: src/Config/tweaks.php:246
msgid "Extends the login cookie to 1 year when Remember Me is checked. Without the checkbox the default session length stays unchanged. Do not enable on shared computers."
msgstr ""

#: src/Config/tweaks.php:250
msgid "Disable wp-embed script on frontend"
msgstr ""

#: src/Config/tweaks.php:252
msgid "Disables the wp-embed.js script WordPress loads for post embeds. On a regular site it is rarely needed and saves a few kilobytes."
msgstr ""

#: src/Config/tweaks.php:256
msgid "Disable dashicons CSS for guests"
msgstr ""

#: src/Config/tweaks.php:258
msgid "Does not load dashicons CSS for logged-out visitors. Saves about 30 KB if the frontend has no admin UI elements."
msgstr ""

#: src/Config/tweaks.php:262
msgid "⚠️ Disable REST API for unauthorized users"
msgstr ""

#: src/Config/tweaks.php:264
msgid "Closes the REST API for guests. Improves security but may break some forms, frontend Gutenberg blocks, and integrations. Enable only after testing."
msgstr ""

#: src/Config/tweaks.php:268
msgid "Noindex for search, attachment and date archives"
msgstr ""

#: src/Config/tweaks.php:270
msgid "Adds noindex for search results, attachment pages, and date archives. These pages are rarely useful in Google and often create duplicates. Different from General Settings → Disable site indexing, which blocks the entire site."
msgstr ""

#: src/Config/tweaks.php:274
msgid "⚠️ Redirect author archives to home page"
msgstr ""

#: src/Config/tweaks.php:276
msgid "Redirects author archive pages /author/name/ to the home page. Useful for a single-author blog. On a multi-author site it is better to leave this off."
msgstr ""

#: src/Config/tweaks.php:280
msgid "Disable theme and plugin file editor in admin"
msgstr ""

#: src/Config/tweaks.php:282
msgid "Prevents editing theme and plugin PHP files from the admin. Recommended for security: changes should go through git or FTP deliberately."
msgstr ""

#: src/Config/tweaks.php:286
msgid "Disable application passwords"
msgstr ""

#: src/Config/tweaks.php:288
msgid "Disables Application Passwords for REST API access. Rarely needed; if you do not use external apps with WP access, it is safer to keep this enabled."
msgstr ""

#: src/Config/tweaks.php:292
msgid "⚠️ Remove global theme styles on frontend"
msgstr ""

#: src/Config/tweaks.php:294
msgid "Removes global-styles and classic-theme-styles on the frontend. It may speed up classic themes but can break blocks and typography. Check the site appearance after enabling."
msgstr ""

#: src/Config/tweaks.php:298
msgid "Remove REST and oEmbed discovery links from head"
msgstr ""

#: src/Config/tweaks.php:300
msgid "Removes REST API and oEmbed discovery links from the head. Visitors do not need them, and they reveal extra site structure."
msgstr ""

#: src/Config/tweaks.php:304
msgid "Block WordPress and Automattic tracking pixel"
msgstr ""

#: src/Config/tweaks.php:306
msgid "Blocks requests to pixel.wp.com, stats.wp.com, and WordPress Events in the admin. Also disables WooCommerce/Jetpack tracking when those plugins are installed. Does not block core updates."
msgstr ""

#: src/Config/wp-addon-settings.php:519
msgid "Как работают перенаправления"
msgstr ""

#: src/Config/wp-addon-settings.php:521
#, php-format
msgid "Плагин отдаёт ответ %1$s и перенаправляет посетителя с одного адреса на другой. Указывайте пути без домена — от корня WordPress, например %2$s (не /wp/old-page/, если сайт в подпапке). Абсолютные URL (https://...) — только в поле «Куда». Запросы к %3$s и %4$s никогда не перенаправляются."
msgstr ""

#: src/Config/wp-addon-settings.php:529
msgid "Слеш в конце URL"
msgstr ""

#: src/Config/wp-addon-settings.php:530
msgid "/page и /page/ считаются одинаковыми. Можно писать в любом виде — плагин сравнивает пути без учёта завершающего слеша."
msgstr ""

#: src/Config/wp-addon-settings.php:531
msgid "Простые правила"
msgstr ""

#: src/Config/wp-addon-settings.php:535
msgid "Массовый импорт CSV"
msgstr ""

#: src/Config/wp-addon-settings.php:536
msgid "Одна строка = одно правило. Разделители: запятая, ; или табуляция. Строки с # — комментарии. После сохранения правила попадут в список ниже."
msgstr ""

#: src/Config/wp-addon-settings.php:539
msgid "Подстановочный знак * (не regex)"
msgstr ""

#: src/Config/wp-addon-settings.php:540
msgid "Это не полноценные регулярные выражения — поддерживается только символ *. Включите опцию «Подстановочные знаки» выше."
msgstr ""

#: src/Config/wp-addon-settings.php:546
msgid "Что важно помнить"
msgstr ""

#: src/Config/wp-addon-settings.php:547
msgid "Параметры запроса (?utm=...) при сравнении не учитываются. Если правило совпало — редирект сработает и для URL с query string. Не создавайте циклы: /a → /b и /b → /a."
msgstr ""

#: src/Config/wp-addon-settings.php:558
msgid "каталог rwsite"
msgstr ""

#: src/Config/wp-addon-settings.php:558
msgid "GitHub"
msgstr ""

#: src/Config/wp-addon-settings.php:566
#, php-format
msgid "Показано: %1$s из %2$d. Источник: %3$s."
msgstr ""

#: src/Config/wp-addon-settings.php:573
msgid "Обновить список"
msgstr ""

#: src/Config/wp-addon-settings.php:578
msgid "Поиск по названию, описанию или репозиторию"
msgstr ""

#: src/Config/wp-addon-settings.php:578
msgid "Поиск плагинов"
msgstr ""

#: src/Config/wp-addon-settings.php:579
msgid "Категория"
msgstr ""

#: src/Config/wp-addon-settings.php:580
msgid "Все категории"
msgstr ""

#: src/Config/wp-addon-settings.php:592
msgid "Не удалось загрузить список плагинов:"
msgstr ""

#: src/Config/wp-addon-settings.php:594
msgid "Не удалось загрузить список плагинов."
msgstr ""

#: src/Config/wp-addon-settings.php:598
msgid "По вашему запросу ничего не найдено."
msgstr ""

#: src/Config/wp-addon-settings.php:908
msgid "Wordpress Addon"
msgstr ""

#: src/Config/wp-addon-settings.php:919
msgid "General Settings"
msgstr ""

#: src/Config/wp-addon-settings.php:926
msgid "Tweaks"
msgstr ""

#: src/Config/wp-addon-settings.php:933
msgid "Cache"
msgstr ""

#: src/Config/wp-addon-settings.php:935
msgid "Page caching saves ready HTML and gzip files. Apache rules are installed automatically. For Nginx, include the generated wp-content/cache/pages/nginx.conf file inside the HTTPS server block and reload Nginx. Disable other full-page cache plugins to avoid conflicts."
msgstr ""

#: src/Config/wp-addon-settings.php:940
msgid "Enable page caching"
msgstr ""

#: src/Config/wp-addon-settings.php:941
msgid "Main switch for enabling/disabling cache. When ON: all site pages are saved to cache. When OFF: cache is not used, pages are generated each time anew."
msgstr ""

#: src/Config/wp-addon-settings.php:947
msgid "Cache lifetime (seconds)"
msgstr ""

#: src/Config/wp-addon-settings.php:948
msgid "How long browsers may reuse a cached page. Cached files are also purged automatically whenever posts, terms, comments, menus, widgets or theme settings change. The recommended default is 3600 seconds."
msgstr ""

#: src/Config/wp-addon-settings.php:956
msgid "Do not cache for logged-in users"
msgstr ""

#: src/Config/wp-addon-settings.php:957
msgid "If a user is logged into admin or personal account - show them fresh pages without cache. Otherwise, they may not see their changes or notifications."
msgstr ""

#: src/Config/wp-addon-settings.php:963
msgid "Do not cache these pages"
msgstr ""

#: src/Config/wp-addon-settings.php:964
msgid "Pages that change frequently and should not be cached. One line - one URL. Examples: /wp-admin/ (admin), /checkout/ (checkout), /cart/ (cart), /my-account/ (personal account)."
msgstr ""

#: src/Config/wp-addon-settings.php:970
msgid "Preload these pages"
msgstr ""

#: src/Config/wp-addon-settings.php:971
msgid "Pages for auto-caching every hour. <strong>Leave empty for automatic mode:</strong> the home page + all pages from the main site menu (up to 10 pcs) will be loaded. Or specify manually: one URL per line, for example /about/, /services/"
msgstr ""

#: src/Config/wp-addon-settings.php:977
msgid "Clear cache on post publish"
msgstr ""

#: src/Config/wp-addon-settings.php:978
msgid "When you publish a new article or edit an old one - automatically delete all cache. So readers will immediately see fresh content. Disable if you publish often - this will slow down the site."
msgstr ""

#: src/Config/wp-addon-settings.php:991
msgid "Asset Minification"
msgstr ""

#: src/Config/wp-addon-settings.php:993
msgid "Asset optimization is a comprehensive system for improving site performance by minifying and combining CSS/JavaScript files. The module automatically analyzes all connected resources and applies optimal optimization strategies.<br><br><strong>Benefits:</strong><br>• Reduce file size by 20-40%<br>• Decrease number of HTTP requests<br>• Speed up page loading<br>• Better PageSpeed Insights scores<br><br><strong>Automatic logic:</strong><br>• Excludes WordPress system resources<br>• Does not process files smaller than 1KB<br>• Skips already minified files<br>• Analyzes resource loading priorities"
msgstr ""

#: src/Config/wp-addon-settings.php:998
msgid "Enable asset optimization"
msgstr ""

#: src/Config/wp-addon-settings.php:999
msgid "Main switch of the optimization module. When enabled, intelligent processing of all CSS and JavaScript resources on the site is activated. Recommended to enable on production sites for maximum performance."
msgstr ""

#: src/Config/wp-addon-settings.php:1005
msgid "Minify CSS files"
msgstr ""

#: src/Config/wp-addon-settings.php:1006
msgid "Removes from CSS files: comments, extra spaces, line breaks and tabs. Does not process files that are already minified or smaller than 1KB. Traffic savings: 15-30% per file."
msgstr ""

#: src/Config/wp-addon-settings.php:1013
msgid "Minify JavaScript files"
msgstr ""

#: src/Config/wp-addon-settings.php:1014
msgid "Compresses JS code by removing comments, extra spaces and formatting. Skips minified files and files smaller than 1KB. Important: check functionality after enabling, as some plugins may have minification-sensitive code."
msgstr ""

#: src/Config/wp-addon-settings.php:1021
msgid "Combine CSS files"
msgstr ""

#: src/Config/wp-addon-settings.php:1022
msgid "Collects all suitable CSS files into one combined file, reducing the number of HTTP requests to the server. Automatically excludes WordPress system styles. Effective for sites with 3+ CSS files."
msgstr ""

#: src/Config/wp-addon-settings.php:1029
msgid "Combine JavaScript files"
msgstr ""

#: src/Config/wp-addon-settings.php:1030
msgid "Combines JS files into one loaded in the footer. Reduces the number of requests, but may break loading order. Recommended to test for JavaScript errors after enabling."
msgstr ""

#: src/Config/wp-addon-settings.php:1037
msgid "Implement critical CSS"
msgstr ""

#: src/Config/wp-addon-settings.php:1038
msgid "Automatically extracts and embeds inline critical CSS styles (header, menu, main content) for instant display of above-the-fold content. Improves First Contentful Paint score in Lighthouse."
msgstr ""

#: src/Config/wp-addon-settings.php:1045
msgid "Defer non-critical CSS"
msgstr ""

#: src/Config/wp-addon-settings.php:1046
msgid "Loads non-critical CSS files asynchronously after page rendering. Prevents render blocking, but may cause brief \"flash of unstyled content\" (FOUC)."
msgstr ""

#: src/Config/wp-addon-settings.php:1053
msgid "Exclude CSS files"
msgstr ""

#: src/Config/wp-addon-settings.php:1054
msgid "List of CSS file handles separated by comma that should not be optimized. Examples: critical-styles, admin-css, custom-admin-styles. WordPress system files are excluded automatically."
msgstr ""

#: src/Config/wp-addon-settings.php:1061
msgid "Exclude JavaScript files"
msgstr ""

#: src/Config/wp-addon-settings.php:1062
msgid "JS file handles separated by comma for exclusion from optimization. Examples: google-analytics, facebook-pixel, custom-scripts. WordPress system scripts (jQuery, etc.) are excluded automatically."
msgstr ""

#: src/Config/wp-addon-settings.php:1071
msgid "Lazy Loading"
msgstr ""

#: src/Config/wp-addon-settings.php:1073
msgid "Lazy loading of images and media files is a performance optimization technique where resources are loaded only when they come into the user's view. The module uses the modern Intersection Observer API with fallback for older browsers.<br><br><strong>Benefits:</strong><br>• Reduced page load time<br>• Traffic savings (especially on mobile devices)<br>• Improved Core Web Vitals (LCP, CLS)<br>• Automatic image compression with blur placeholder<br><br><strong>Support:</strong><br>• Images (img)<br>• Iframe (YouTube, Vimeo videos)<br>• Video elements<br>• Blur placeholder for smooth loading<br>• Fallback for IE11+"
msgstr ""

#: src/Config/wp-addon-settings.php:1078
msgid "Enable lazy loading"
msgstr ""

#: src/Config/wp-addon-settings.php:1079
msgid "Main switch of the module. When enabled, lazy loading is activated for selected media types. Recommended to enable on all sites for improved performance."
msgstr ""

#: src/Config/wp-addon-settings.php:1085
msgid "Media types for lazy loading"
msgstr ""

#: src/Config/wp-addon-settings.php:1086
msgid "Select element types for which lazy loading will be applied. Images are most effective for optimization."
msgstr ""

#: src/Config/wp-addon-settings.php:1088
msgid "Images (img)"
msgstr ""

#: src/Config/wp-addon-settings.php:1089
msgid "Iframe (YouTube, Vimeo)"
msgstr ""

#: src/Config/wp-addon-settings.php:1090
msgid "Video elements"
msgstr ""

#: src/Config/wp-addon-settings.php:1098
msgid "Blur effect intensity"
msgstr ""

#: src/Config/wp-addon-settings.php:1099
msgid "Degree of blur placeholder blur. Value 1 - weak blur, 10 - strong. Recommended 3-7 for optimal quality and performance balance."
msgstr ""

#: src/Config/wp-addon-settings.php:1108
msgid "Viewport margin (rootMargin)"
msgstr ""

#: src/Config/wp-addon-settings.php:1109
msgid "Distance from viewport edge at which to start loading. Example: 50px - loading 50px before element appears. 10% - 10% of viewport height."
msgstr ""

#: src/Config/wp-addon-settings.php:1119
msgid "Visibility threshold"
msgstr ""

#: src/Config/wp-addon-settings.php:1120
msgid "The portion of the element that must enter the viewport to start loading. 0.1 = 10% of element visible. 1.0 = entire element visible."
msgstr ""

#: src/Config/wp-addon-settings.php:1130
msgid "Enable fallback for older browsers"
msgstr ""

#: src/Config/wp-addon-settings.php:1131
msgid "Use scroll event listeners instead of Intersection Observer in browsers without IO API support. Slows performance but ensures compatibility."
msgstr ""

#: src/Config/wp-addon-settings.php:1140
msgid "Media Cleanup"
msgstr ""

#: src/Config/wp-addon-settings.php:1142
msgid "This section allows you to clean up unused image sizes to free up disk space. WordPress generates multiple sizes for each uploaded image, but if your theme or plugins don't use all of them, they take up unnecessary space. Use this tool to identify and remove such files.<br><br><strong>When to use:</strong> After changing themes, disabling plugins that generate custom sizes, or optimizing site performance.<br><br><strong>Precautions:</strong> Always create a backup before cleanup. Use \"Preview Cleanup\" first to see what will be deleted. The tool preserves original images and \"scaled\" versions (up to 2000px). Deleted files cannot be recovered!"
msgstr ""

#: src/Config/wp-addon-settings.php:1147
msgid "Enable Media Cleanup"
msgstr ""

#: src/Config/wp-addon-settings.php:1148
msgid "Registers the cleanup AJAX actions. Keep disabled until you are ready to review and remove generated image sizes."
msgstr ""

#: src/Config/wp-addon-settings.php:1154
msgid "Clean up unused image sizes"
msgstr ""

#: src/Config/wp-addon-settings.php:1156
#, php-format
msgid "This will delete all image sizes except: %s. Files will be deleted permanently!"
msgstr ""

#: src/Config/wp-addon-settings.php:1156
msgid "Preview Cleanup"
msgstr ""

#: src/Config/wp-addon-settings.php:1156
msgid "Start Cleanup"
msgstr ""

#: src/Config/wp-addon-settings.php:1156
msgid "Loading preview..."
msgstr ""

#: src/Config/wp-addon-settings.php:1156
msgid "Are you sure? This action cannot be undone."
msgstr ""

#: src/Config/wp-addon-settings.php:1156
msgid "Processing..."
msgstr ""

#: src/Config/wp-addon-settings.php:1163
msgid "Redirects"
msgstr ""

#: src/Config/wp-addon-settings.php:1165
msgid "301 redirect management for old URLs, moved pages and bulk migrations. Read the guide below for slash rules, wildcard examples and CSV import format."
msgstr ""

#: src/Config/wp-addon-settings.php:1174
msgid "Enable redirects"
msgstr ""

#: src/Config/wp-addon-settings.php:1175
msgid "When disabled, redirect rules are saved but not applied on the site."
msgstr ""

#: src/Config/wp-addon-settings.php:1181
msgid "Use wildcard redirects"
msgstr ""

#: src/Config/wp-addon-settings.php:1182
msgid "Required for rules with *. Without this option only exact URL matches work, e.g. /old-page/ → /new-page/."
msgstr ""

#: src/Config/wp-addon-settings.php:1188
msgid "Bulk CSV import"
msgstr ""

#: src/Config/wp-addon-settings.php:1189
msgid "Paste rules here and save settings. Format: source,destination — one rule per line. Duplicate source URLs are overwritten. The field is cleared after a successful import."
msgstr ""

#: src/Config/wp-addon-settings.php:1206
msgid "Redirect rules"
msgstr ""

#: src/Config/wp-addon-settings.php:1207
msgid "Manual rule list. «Request URL» is the old address visitors open. «Destination URL» is where they should land. Trailing slashes are optional."
msgstr ""

#: src/Config/wp-addon-settings.php:1212
msgid "Request URL"
msgstr ""

#: src/Config/wp-addon-settings.php:1213
msgid "Old URL path relative to site root. Examples: /old-page/, /old-page (same), /old-folder/* with wildcards enabled."
msgstr ""

#: src/Config/wp-addon-settings.php:1221
msgid "Destination URL"
msgstr ""

#: src/Config/wp-addon-settings.php:1222
msgid "New address: site path (/new-page/) or full URL (https://example.com/page/). For wildcards use * in the same position as in the source."
msgstr ""

#: src/Config/wp-addon-settings.php:1235
msgid "Shortcodes and Widgets"
msgstr ""

#: src/Config/wp-addon-settings.php:1242
msgid "Cookie Banner"
msgstr ""

#: src/Config/wp-addon-settings.php:1244
msgid "Cookie consent banner with configurable text, links, button mode and deferred analytics loading."
msgstr ""

#: src/Config/wp-addon-settings.php:1252
msgid "Custom code"
msgstr ""

#: src/Config/wp-addon-settings.php:1258
msgid "CSS Code in Header"
msgstr ""

#: src/Config/wp-addon-settings.php:1268
msgid "Any HTML code or Analytics code in header."
msgstr ""

#: src/Config/wp-addon-settings.php:1280
msgid "Any HTML code in footer."
msgstr ""

#: src/Config/wp-addon-settings.php:1295
msgid "Markdown Editor позволяет писать и редактировать контент в удобном Markdown-синтаксисе. При сохранении Markdown автоматически конвертируется в HTML и сохраняется в основное поле контента — сам исходник Markdown нигде не хранится, и посты на сайте всегда отдают чистый HTML.<br><br><strong>Как работает синхронизация с обычным редактором:</strong><br>• если контент правили в Markdown — сохраненный HTML получается из Markdown<br>• если правили только в стандартном редакторе (TinyMCE) — его HTML сохраняется как есть, а Markdown-поле просто обновляется при следующем открытии"
msgstr ""

#: src/Config/wp-addon-settings.php:1300
msgid "Enable Markdown editor"
